  "info": {
    "title": "Helpdesk API – служба технічної підтримки коледжу",
    "description": "REST API служби технічної підтримки коледжу (генерація code-first із контролерів і DTO NestJS)",
    "version": "1.0.0",
    "contact": {}
  },
  "tags": [
    {
      "name": "auth",
      "description": "Автентифікація"
    },
    {
      "name": "tickets",
      "description": "Заявки та їх життєвий цикл"
    },
    {
      "name": "comments",
      "description": "Коментарі до заявок"
    },
    {
      "name": "users",
      "description": "Користувачі системи"
    }
  ],
  "servers": [
    {
      "url": "http://localhost:3000/api/v1",
      "description": "Локальний сервер розробки"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http",
        "description": "Токен з POST /auth/login"
      }
    },
    "schemas": {
      "ProblemDetailsEntity": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "description": "URI типу проблеми",
            "example": "about:blank"
          },
          "title": {
            "type": "string",
            "description": "Короткий заголовок класу помилки",
            "example": "Помилка валідації даних"
          },
          "status": {
            "type": "integer",
            "description": "Числовий HTTP-код стану",
            "example": 422
          },
          "detail": {
            "type": "string",
            "description": "Детальний опис конкретної помилки",
            "example": "Дані не відповідають вимогам"
          },
          "instance": {
            "type": "string",
            "description": "Шлях запиту, під час якого виникла помилка",
            "example": "/api/v1/tickets"
          },
          "requestId": {
            "type": "string",
            "description": "Ідентифікатор запиту для трасування в журналі",
            "example": "9f3c2a10-4b7d-4e1a-8c3b-1234567890ab"
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "detail",
          "instance"
        ]
      },
      "UserRole": {
        "type": "string",
        "enum": [
          "student",
          "teacher",
          "admin"
        ],
        "description": "Роль користувача в системі"
      },
      "UserEntity": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "description": "Унікальний ідентифікатор користувача",
            "example": 1,
            "readOnly": true
          },
          "fullName": {
            "type": "string",
            "description": "ПІБ користувача",
            "example": "Петренко Андрій Іванович"
          },
          "email": {
            "type": "string",
            "description": "Електронна пошта користувача",
            "example": "a.petrenko@college.example.ua",
            "format": "email"
          },
          "role": {
            "description": "Роль користувача в системі",
            "example": "student",
            "allOf": [
              {
                "$ref": "#/components/schemas/UserRole"
              }
            ]
          }
        },
        "required": [
          "id",
          "fullName",
          "email",
          "role"
        ]
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "description": "Електронна пошта користувача",
            "example": "a.petrenko@college.example.ua",
            "format": "email"
          },
          "password": {
            "type": "string",
            "description": "Пароль користувача",
            "example": "student123",
            "format": "password"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "TokenEntity": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string",
            "description": "Токен доступу",
            "example": "2f1c9a54-8d3e-4b7a-9f1e-6c2d8a4b0e71"
          },
          "tokenType": {
            "description": "Схема авторизації",
            "example": "Bearer",
            "enum": [
              "Bearer"
            ],
            "type": "string"
          },
          "expiresIn": {
            "type": "integer",
            "description": "Час дії токена в секундах",
            "example": 3600
          }
        },
        "required": [
          "accessToken",
          "tokenType",
          "expiresIn"
        ]
      },
      "TicketStatus": {
        "type": "string",
        "enum": [
          "open",
          "in_progress",
          "resolved",
          "closed"
        ],
        "description": "Поточний стан заявки"
      },
      "Priority": {
        "type": "string",
        "enum": [
          "low",
          "medium",
          "high",
          "critical"
        ],
        "description": "Пріоритет заявки"
      },
      "TicketEntity": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "description": "Ідентифікатор заявки",
            "example": 1,
            "readOnly": true
          },
          "title": {
            "type": "string",
            "description": "Коротка назва проблеми",
            "example": "Не працює проєктор в ауд. 214"
          },
          "description": {
            "type": "string",
            "description": "Докладний опис проблеми",
            "example": "Немає сигналу з HDMI"
          },
          "status": {
            "description": "Поточний стан заявки",
            "example": "open",
            "allOf": [
              {
                "$ref": "#/components/schemas/TicketStatus"
              }
            ]
          },
          "priority": {
            "description": "Пріоритет заявки",
            "example": "high",
            "allOf": [
              {
                "$ref": "#/components/schemas/Priority"
              }
            ]
          },
          "authorId": {
            "type": "integer",
            "description": "Ідентифікатор автора заявки",
            "example": 2,
            "readOnly": true
          },
          "assigneeId": {
            "type": "integer",
            "nullable": true,
            "description": "Виконавець; null – не призначено",
            "example": 3
          },
          "createdAt": {
            "type": "string",
            "description": "Дата і час створення заявки",
            "example": "2026-09-01T08:15:00.000Z",
            "format": "date-time",
            "readOnly": true
          },
          "updatedAt": {
            "type": "string",
            "description": "Дата і час останнього оновлення заявки",
            "example": "2026-09-01T08:15:00.000Z",
            "format": "date-time",
            "readOnly": true
          },
          "tags": {
            "description": "Теги заявки",
            "example": [
              "обладнання",
              "аудиторія"
            ],
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "id",
          "title",
          "status",
          "priority",
          "authorId",
          "assigneeId",
          "createdAt",
          "updatedAt",
          "tags"
        ]
      },
      "CreateTicketDto": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "description": "Коротка назва проблеми",
            "example": "Не працює проєктор в ауд. 214",
            "minLength": 1,
            "maxLength": 80
          },
          "description": {
            "type": "string",
            "description": "Докладний опис проблеми",
            "example": "Немає сигналу з HDMI",
            "maxLength": 500
          },
          "priority": {
            "description": "Пріоритет заявки",
            "example": "high",
            "allOf": [
              {
                "$ref": "#/components/schemas/Priority"
              }
            ]
          },
          "tags": {
            "description": "Теги заявки",
            "example": [
              "обладнання",
              "аудиторія"
            ],
            "maxItems": 10,
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "title",
          "priority"
        ]
      },
      "UpdateTicketDto": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "description": "Коротка назва проблеми",
            "example": "Не працює проєктор в ауд. 214",
            "minLength": 1,
            "maxLength": 80
          },
          "description": {
            "type": "string",
            "description": "Докладний опис проблеми",
            "example": "Немає сигналу з HDMI",
            "maxLength": 500
          },
          "priority": {
            "description": "Пріоритет заявки",
            "example": "high",
            "allOf": [
              {
                "$ref": "#/components/schemas/Priority"
              }
            ]
          },
          "tags": {
            "description": "Теги заявки",
            "example": [
              "обладнання",
              "аудиторія"
            ],
            "maxItems": 10,
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "assigneeId": {
            "type": "integer",
            "nullable": true,
            "description": "Ідентифікатор виконавця; null – зняти виконавця",
            "example": 3,
            "minimum": 1
          }
        }
      },
      "ChangeStatusDto": {
        "type": "object",
        "properties": {
          "status": {
            "description": "Цільовий стан заявки",
            "example": "in_progress",
            "allOf": [
              {
                "$ref": "#/components/schemas/TicketStatus"
              }
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "CommentEntity": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "description": "Ідентифікатор коментаря",
            "example": 1,
            "readOnly": true
          },
          "ticketId": {
            "type": "integer",
            "description": "Ідентифікатор заявки",
            "example": 1,
            "readOnly": true
          },
          "authorId": {
            "type": "integer",
            "description": "Ідентифікатор автора коментаря",
            "example": 3,
            "readOnly": true
          },
          "text": {
            "type": "string",
            "description": "Текст коментаря",
            "example": "Замінили кабель"
          },
          "createdAt": {
            "type": "string",
            "description": "Дата і час створення коментаря",
            "example": "2026-09-01T09:00:00.000Z",
            "format": "date-time",
            "readOnly": true
          }
        },
        "required": [
          "id",
          "ticketId",
          "authorId",
          "text",
          "createdAt"
        ]
      },
      "CreateCommentDto": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "description": "Текст коментаря",
            "example": "Замінили кабель",
            "minLength": 1,
            "maxLength": 1000
          }
        },
        "required": [
          "text"
        ]
      }
    }
  },
  "security": [
    {
      "bearer": []
    }
  ]
